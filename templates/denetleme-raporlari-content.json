      "children": [
        {
          "type": "render-template",
          "isContainer": false,
          "isTextEditor": true,
          "content": "<div class=\"dr__hero\">\n  <div class=\"dr__hero-main\">\n    <span class=\"dr__eyebrow\">Operasyon denetimi</span>\n    <h1>Denetleme Raporları</h1>\n    <p>Şubelerin son denetleme tarihi ve puan özeti</p>\n  </div>\n  {{#if departments.length}}<span class=\"dr__count\">{{departments.length}} şube</span>{{/if}}\n</div>",
          "properties": [
            {
              "key": "display-name",
              "header": "Display name",
              "type": "input-text-property",
              "value": "Sayfa hero"
            }
          ]
        },
