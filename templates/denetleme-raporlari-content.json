                    {
                      "type": "render-template",
                      "isContainer": false,
                      "isTextEditor": true,
                      "content": "<div class=\"dr-card__header\">\n  {{#if input.short}}<span class=\"dr-card__code\">{{input.short}}</span>{{/if}}\n  <h3 class=\"dr-card__title\">{{input.label}}</h3>\n</div>\n\n<div class=\"dr-card__metrics\">\n  <div class=\"dr-card__metric\">\n    <span class=\"dr-card__metric-label\">Son denetleme</span>\n    {{#if input.lastInspection.datetime}}\n    <span class=\"dr-card__metric-value\">{{renderDateTime input.lastInspection.datetime}}</span>\n    {{else}}\n    <span class=\"dr-card__metric-value dr-card__metric-value--muted\">Henüz yok</span>\n    {{/if}}\n  </div>\n\n  <div class=\"dr-card__metric\">\n    <span class=\"dr-card__metric-label\">Puan</span>\n    {{#if input.lastInspection.total.point}}\n    <div class=\"dr-card__score\">\n      <span class=\"dr-card__score-num\">{{input.lastInspection.total.point}}</span>\n      <span class=\"dr-card__score-max\">/5</span>\n    </div>\n    {{#if input.lastInspection.resultText}}\n    <span class=\"dr-card__badge\">{{input.lastInspection.resultText}}</span>\n    {{/if}}\n    {{else}}\n    <span class=\"dr-card__metric-value dr-card__metric-value--muted\">—</span>\n    {{/if}}\n  </div>\n</div>",
                      "properties": [
