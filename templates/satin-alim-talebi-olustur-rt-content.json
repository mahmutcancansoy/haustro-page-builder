{
  "content": [
    {
      "type": "render-template",
      "isContainer": false,
      "isTextEditor": true,
      "content": "<style>\n.sat-rt{font-family:'Inter',-apple-system,sans-serif;color:#0f172a;padding:0 0 24px}\n.sat-rt__header{background:#586495;color:#fff;padding:16px 20px;border-radius:0 0 12px 12px;margin:-8px -8px 20px;font-size:18px;font-weight:700}\n.sat-rt__card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:20px;margin-bottom:16px;box-shadow:0 1px 2px rgba(15,23,42,.04)}\n.sat-rt__label{font-size:13px;font-weight:600;color:#475569;margin-bottom:10px;display:block}\n.sat-rt__radios{display:flex;flex-direction:column;gap:10px}\n.sat-rt__radio{display:flex;align-items:center;gap:10px;padding:12px 14px;border:1px solid #e2e8f0;border-radius:10px;cursor:pointer;transition:border-color .15s,background .15s}\n.sat-rt__radio:hover{border-color:#818cf8;background:#f8fafc}\n.sat-rt__radio input{accent-color:#586495;width:18px;height:18px}\n.sat-rt__panel{display:none;margin-top:16px;padding-top:16px;border-top:1px dashed #e2e8f0}\n.sat-rt__panel.is-visible{display:block}\n.sat-rt__hint{font-size:12px;color:#64748b;margin-top:8px}\n.sat-rt__status{font-size:11px;color:#94a3b8;margin-top:12px;font-family:ui-monospace,monospace}\n.sat-rt__field{margin-bottom:14px}\n.sat-rt__field label{display:block;font-size:12px;font-weight:600;color:#64748b;margin-bottom:6px}\n.sat-rt__field input,.sat-rt__field select,.sat-rt__field textarea{width:100%;max-width:480px;padding:10px 12px;border:1px solid #cbd5e1;border-radius:8px;font-size:14px}\n.sat-rt__field textarea{min-height:80px;resize:vertical}\n.sat-rt__actions{margin-top:20px;display:flex;gap:10px;flex-wrap:wrap}\n.sat-rt__btn{padding:10px 18px;border-radius:8px;font-size:14px;font-weight:600;border:none;cursor:pointer}\n.sat-rt__btn--primary{background:#586495;color:#fff}\n.sat-rt__btn--ghost{background:#f1f5f9;color:#334155;border:1px solid #e2e8f0}\n</style>\n\n<div class=\"sat-rt\" id=\"sat-rt-root\">\n  <div class=\"sat-rt__header\">Satın Alım Talebi Oluştur</div>\n\n  <div class=\"sat-rt__card\">\n    <span class=\"sat-rt__label\">Satın Alma Türü</span>\n    <div class=\"sat-rt__radios\">\n      <label class=\"sat-rt__radio\">\n        <input type=\"radio\" name=\"purchaseType\" value=\"0\" />\n        <span>Envanter Satın Alımı</span>\n      </label>\n      <label class=\"sat-rt__radio\">\n        <input type=\"radio\" name=\"purchaseType\" value=\"1\" />\n        <span>Hizmet Satın Alımı</span>\n      </label>\n    </div>\n    <p class=\"sat-rt__hint\">Sayfa yalnızca <code>render-template</code> ile çalışır; backend çağrısı olarak yalnızca <code>emptyResponse</code> kullanılır.</p>\n    <div class=\"sat-rt__status\" id=\"sat-rt-status\">emptyResponse bekleniyor…</div>\n  </div>\n\n  <div class=\"sat-rt__card sat-rt__panel\" id=\"sat-rt-panel-0\" data-type=\"0\">\n    <h3 style=\"margin:0 0 12px;font-size:15px\">Envanter satın alım talebi</h3>\n    <div class=\"sat-rt__field\">\n      <label>Departman (metin)</label>\n      <input type=\"text\" name=\"departmentLabel\" placeholder=\"Departman\" />\n    </div>\n    <div class=\"sat-rt__field\">\n      <label>Envanter (metin)</label>\n      <input type=\"text\" name=\"inventoryLabel\" placeholder=\"Envanter\" />\n    </div>\n    <div class=\"sat-rt__field\">\n      <label>Adet</label>\n      <input type=\"number\" name=\"count\" min=\"1\" value=\"1\" />\n    </div>\n    <div class=\"sat-rt__field\">\n      <label>Açıklama</label>\n      <textarea name=\"description\" placeholder=\"Talep açıklaması\"></textarea>\n    </div>\n  </div>\n\n  <div class=\"sat-rt__card sat-rt__panel\" id=\"sat-rt-panel-1\" data-type=\"1\">\n    <h3 style=\"margin:0 0 12px;font-size:15px\">Hizmet satın alım talebi</h3>\n    <div class=\"sat-rt__field\">\n      <label>Hizmet kategorisi (metin)</label>\n      <input type=\"text\" name=\"serviceCategory\" placeholder=\"Kategori\" />\n    </div>\n    <div class=\"sat-rt__field\">\n      <label>Açıklama</label>\n      <textarea name=\"description\" placeholder=\"Talep açıklaması\"></textarea>\n    </div>\n  </div>\n\n  <div class=\"sat-rt__actions\">\n    <button type=\"button\" class=\"sat-rt__btn sat-rt__btn--primary\" id=\"sat-rt-save\">Kaydet (emptyResponse)</button>\n    <button type=\"button\" class=\"sat-rt__btn sat-rt__btn--ghost\" id=\"sat-rt-reset\">Sıfırla</button>\n  </div>\n</div>\n\n<script>\n(function () {\n  var statusEl = document.getElementById('sat-rt-status');\n  var root = document.getElementById('sat-rt-root');\n  if (!root || !statusEl) return;\n\n  function collectPost() {\n    var pt = root.querySelector('input[name=\"purchaseType\"]:checked');\n    var post = { purchaseType: pt ? pt.value : '' };\n    var panel = pt ? document.getElementById('sat-rt-panel-' + pt.value) : null;\n    if (panel) {\n      panel.querySelectorAll('input, textarea, select').forEach(function (el) {\n        if (!el.name || el.name === 'purchaseType') return;\n        post[el.name] = el.value;\n      });\n    }\n    return post;\n  }\n\n  function callEmptyResponse(post) {\n    statusEl.textContent = 'emptyResponse çağrılıyor…';\n    return fetch('/custom/emptyResponse', {\n      method: 'POST',\n      credentials: 'include',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ data: {}, post: post || {} }),\n    })\n      .then(function (r) { return r.json(); })\n      .then(function (json) {\n        statusEl.textContent = 'emptyResponse OK: ' + JSON.stringify(json.response || json);\n        return json;\n      })\n      .catch(function (err) {\n        statusEl.textContent = 'emptyResponse hata: ' + (err && err.message ? err.message : String(err));\n      });\n  }\n\n  function showPanel() {\n    var pt = root.querySelector('input[name=\"purchaseType\"]:checked');\n    root.querySelectorAll('.sat-rt__panel').forEach(function (p) {\n      p.classList.toggle('is-visible', pt && p.getAttribute('data-type') === pt.value);\n    });\n  }\n\n  root.querySelectorAll('input[name=\"purchaseType\"]').forEach(function (radio) {\n    radio.addEventListener('change', function () {\n      showPanel();\n      callEmptyResponse(collectPost());\n    });\n  });\n\n  document.getElementById('sat-rt-save').addEventListener('click', function () {\n    callEmptyResponse(collectPost());\n  });\n\n  document.getElementById('sat-rt-reset').addEventListener('click', function () {\n    root.querySelectorAll('input[type=\"text\"], input[type=\"number\"], textarea').forEach(function (el) {\n      if (el.name === 'purchaseType') return;\n      el.value = el.type === 'number' ? '1' : '';\n    });\n    root.querySelectorAll('input[name=\"purchaseType\"]').forEach(function (r) { r.checked = false; });\n    showPanel();\n    callEmptyResponse({ purchaseType: '' });\n  });\n\n  callEmptyResponse({ purchaseType: '' });\n})();\n</script>",
      "properties": [
        {
          "key": "display-name",
          "header": "Display name",
          "type": "input-text-property",
          "value": "Satın Alım Talebi — Render Template"
        }
      ]
    }
  ],
  "styles": ""
}