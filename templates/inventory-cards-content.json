{
  "content": [
    {
      "type": "data-source",
      "isContainer": false,
      "children": [],
      "properties": [
        {
          "key": "display-name",
          "header": "Display name",
          "type": "input-text-property",
          "value": "envanter listesi"
        },
        {
          "key": "variable-name",
          "header": "Variable name",
          "type": "input-text-property",
          "value": "inventory"
        },
        {
          "key": "function",
          "header": "Function",
          "type": "select-property",
          "options": [
            { "label": "Get", "value": "get" },
            { "label": "Custom", "value": "custom" }
          ],
          "value": "get"
        },
        {
          "key": "table-name",
          "header": "Table name",
          "type": "input-text-property",
          "value": "inventory",
          "conditions": [
            { "key": "function", "rule": "value == 'get'" }
          ]
        },
        {
          "key": "custom-function-name",
          "header": "Custom function name",
          "type": "input-text-property",
          "value": "",
          "conditions": [
            { "key": "function", "rule": "value == 'custom'" }
          ]
        },
        {
          "key": "table-filters",
          "header": "Table filters",
          "type": "code-editor",
          "value": "{\n    \"delete\" : 0\n}",
          "autoComplete": true,
          "autoCompleteMode": "template"
        },
        {
          "key": "post-params",
          "header": "Post",
          "type": "code-editor",
          "value": "{\n\n}",
          "autoComplete": true,
          "autoCompleteMode": "template",
          "conditions": [
            { "key": "function", "rule": "value == 'custom'" }
          ]
        },
        {
          "key": "debug-type",
          "header": "Debug type",
          "type": "select-property",
          "options": [
            { "label": "Log", "value": "log" },
            { "label": "Table", "value": "table" }
          ],
          "value": "log",
          "conditions": [
            { "key": "settings", "rule": "value.debug" }
          ]
        },
        {
          "key": "settings",
          "type": "checkbox-property",
          "header": "Settings",
          "options": [
            { "label": "Single data", "name": "single" },
            { "label": "Debug", "name": "debug" },
            { "label": "Can reload", "name": "canReload" },
            { "label": "For table", "name": "forTable" }
          ],
          "value": {
            "single": false,
            "debug": false,
            "canReload": true,
            "forTable": false
          }
        }
      ]
    },
    {
      "type": "render-template",
      "isContainer": false,
      "isTextEditor": true,
      "content": "<style>\n.inv-cards-wrapper{padding:16px;font-family:'Inter',-apple-system,sans-serif}\n.inv-cards-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}\n.inv-cards-title{margin:0;font-size:18px;font-weight:700;color:#1e293b}\n.inv-cards-count{font-size:12px;color:#64748b;background:#f1f5f9;padding:4px 10px;border-radius:999px;font-weight:600}\n.inv-cards-empty{padding:32px;text-align:center;color:#94a3b8;background:#f8fafc;border:1px dashed #e2e8f0;border-radius:12px}\n.inv-cards-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px}\n.inv-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;overflow:hidden;display:flex;flex-direction:column;transition:transform .15s ease,box-shadow .15s ease;box-shadow:0 1px 2px rgba(15,23,42,.04)}\n.inv-card:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(15,23,42,.08)}\n.inv-card__media{position:relative;width:100%;height:160px;background:#f1f5f9;overflow:hidden}\n.inv-card__img{width:100%;height:100%;object-fit:cover;display:block}\n.inv-card__img-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:13px;background:linear-gradient(135deg,#f1f5f9,#e2e8f0)}\n.inv-card__no{position:absolute;top:8px;left:8px;background:rgba(15,23,42,.8);color:#fff;font-size:11px;padding:3px 8px;border-radius:999px;letter-spacing:.3px;font-weight:600}\n.inv-card__body{padding:12px 14px 14px;display:flex;flex-direction:column;gap:6px;flex:1}\n.inv-card__title{font-size:14px;font-weight:700;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.inv-card__subtitle{font-size:12px;color:#64748b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.inv-card__meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px}\n.inv-card__chip{display:inline-flex;align-items:center;gap:4px;background:#f1f5f9;border-radius:8px;padding:3px 8px;font-size:11px;color:#334155}\n.inv-card__chip-label{color:#94a3b8;font-weight:600}\n.inv-card__chip-value{font-weight:700}\n.inv-card__desc{font-size:12px;color:#475569;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n.inv-card__footer{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:8px;padding-top:8px;border-top:1px dashed #e2e8f0}\n.inv-card__price{font-size:14px;font-weight:800;color:#0f172a}\n.inv-card__price small{font-weight:500;color:#64748b;margin-left:2px}\n.inv-card__dims{font-size:11px;color:#64748b;font-weight:500}\n</style>\n\n<div class=\"inv-cards-wrapper\">\n  <div class=\"inv-cards-header\">\n    <h3 class=\"inv-cards-title\">Envanter Listesi</h3>\n    <span class=\"inv-cards-count\">{{inventory.length}} kayıt</span>\n  </div>\n\n  {{#if inventory.length}}\n  <div class=\"inv-cards-grid\">\n    {{#each inventory}}\n    <div class=\"inv-card\">\n      <div class=\"inv-card__media\">\n        {{#if this.photo.0.name}}\n          <img class=\"inv-card__img\" src=\"{{globals.resources}}{{this.photo.0.name}}\" alt=\"{{this.name}}\" loading=\"lazy\" />\n        {{else}}\n          <div class=\"inv-card__img-placeholder\"><span>Görsel Yok</span></div>\n        {{/if}}\n        {{#if this.no}}<span class=\"inv-card__no\">{{this.no}}</span>{{/if}}\n      </div>\n\n      <div class=\"inv-card__body\">\n        <div class=\"inv-card__title\" title=\"{{this.name}}\">{{#if this.name}}{{this.name}}{{else}}-{{/if}}</div>\n        {{#if this.model}}<div class=\"inv-card__subtitle\">{{this.model}}</div>{{/if}}\n\n        <div class=\"inv-card__meta\">\n          {{#if this.code}}\n          <span class=\"inv-card__chip\">\n            <span class=\"inv-card__chip-label\">Kod</span>\n            <span class=\"inv-card__chip-value\">{{this.code}}</span>\n          </span>\n          {{/if}}\n          {{#if this.cins}}\n          <span class=\"inv-card__chip\">\n            <span class=\"inv-card__chip-label\">Cins</span>\n            <span class=\"inv-card__chip-value\">{{this.cins}}</span>\n          </span>\n          {{/if}}\n        </div>\n\n        {{#if this.description}}<div class=\"inv-card__desc\">{{this.description}}</div>{{/if}}\n\n        <div class=\"inv-card__footer\">\n          {{#if this.basePrice}}<span class=\"inv-card__price\">{{this.basePrice}} <small>₺</small></span>{{/if}}\n          {{#if this.width}}<span class=\"inv-card__dims\">{{this.width}} × {{this.height}} × {{this.depth}}</span>{{/if}}\n        </div>\n      </div>\n    </div>\n    {{/each}}\n  </div>\n  {{else}}\n  <div class=\"inv-cards-empty\">Henüz envanter kaydı bulunmuyor.</div>\n  {{/if}}\n</div>",
      "properties": [
        {
          "key": "display-name",
          "header": "Display name",
          "type": "input-text-property",
          "value": "Envanter Kart Listesi"
        }
      ]
    }
  ],
  "styles": ""
}
