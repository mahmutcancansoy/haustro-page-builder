          "options": [
            {
              "label": "Required",
              "name": "required"
            },
            {
              "label": "Minimum Files",
              "name": "minCount"
            }
          ],
          "value": {
            "required": false
          },
          "inGroup": true
        },
        {
          "key": "required-text",
          "header": "Required text",
          "type": "input-text-property",
          "value": "Bu alan gereklidir",
          "conditions": [
            {
              "key": "options",
              "rule": "value.required"
            }
          ],
          "inGroup": true
        },
        {
          "key": "file-at-least",
