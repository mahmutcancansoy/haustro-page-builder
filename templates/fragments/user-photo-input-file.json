        {
          "label": "4 / 3",
          "value": 1.3333333333333333
        },
        {
          "label": "16 / 9",
          "value": 1.7777777777777777
        }
      ],
      "header": "Aspect Ratio",
      "value": 1,
      "conditions": [
        {
          "key": "settings",
          "rule": "value.cropper"
        }
      ]
