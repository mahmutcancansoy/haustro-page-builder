            {
              "key": "options",
              "rule": "value.minCount"
            }
          ]
        },
        {
          "key": "minimum-text",
          "header": "Minimum Count text",
          "type": "input-text-property",
          "value": "Minimum dosya adeti ",
          "conditions": [
            {
              "key": "options",
              "rule": "value.minCount"
            }
          ],
          "inGroup": true
        }
