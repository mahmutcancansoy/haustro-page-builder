    {
      "key": "spacings",
      "header": "Spacings",
      "type": "spacings",
      "unit": "px",
      "margins": [
        0,
        0,
        0,
        0
      ],
      "paddings": [
        0,
        0,
        0,
        0
      ]
    },
    {
      "key": "settings",
      "type": "checkbox-property",
      "header": "Settings",
      "options": [
        {
          "label": "As Base64",
          "name": "asBase64"
        },
        {
          "label": "In container",
          "name": "inContainer"
        },
        {
          "label": "Disabled",
          "name": "disabled"
        },
        {
          "label": "Multiple",
          "name": "multiple"
        },
        {
          "label": "Clear button",
          "name": "clear"
        },
        {
          "label": "Cropper",
          "name": "cropper"
        }
      ],
      "value": {
        "inContainer": false,
        "disabled": false,
        "multiple": false,
        "clear": false
      }
