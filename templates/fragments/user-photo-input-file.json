      "type": "input-number-property",
      "value": 250,
      "min": 1,
      "conditions": [
        {
          "key": "settings",
          "rule": "value.cropper"
        }
      ]
    },
    {
      "key": "cropper-height",
      "header": "Cropper height",
      "type": "input-number-property",
