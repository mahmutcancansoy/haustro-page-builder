{
  "type": "input-file",
  "isContainer": false,
  "properties": [
    {
      "key": "display-name",
      "header": "Display name",
      "type": "input-text-property",
      "value": "Foto Ekle"
    },
    {
      "key": "classes",
      "header": "Classes",
      "type": "textarea-property",
      "value": ""
    },
    {
      "key": "name",
      "header": "Name",
      "type": "input-text-property",
      "value": "photo"
    },
    {
      "key": "label",
      "header": "Label",
      "type": "input-text-property",
      "value": "Foto Ekle:",
      "autoComplete": true,
      "autoCompleteMode": "template",
      "conditions": [
        {
          "key": "settings",
          "rule": "!value.inContainer"
        }
      ]
    },
    {
      "key": "accept",
      "header": "Accepted files",
      "type": "input-text-property",
      "value": ".png, .jpg"
    },
    {
      "key": "max-file-size",
      "header": "Max file size",
      "type": "input-text-property",
      "value": "5242880"
    },
    {
      "key": "file-limit",
      "header": "Max files",
      "type": "input-number-property",
      "value": 10,
      "min": 1,
      "conditions": [
        {
          "key": "settings",
          "rule": "value.multiple"
        }
      ]
    },
    {
      "key": "default-value",
      "header": "Default value",
      "type": "input-text-property",
      "value": "users.photo",
      "autoComplete": true,
      "autoCompleteMode": "variable"
    },
    {
      "key": "base-url",
      "header": "Base url",
      "type": "input-text-property",
