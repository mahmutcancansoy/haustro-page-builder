{
  "formProps": [
    {
      "key": "display-name",
      "header": "Display name",
      "type": "input-text-property",
      "value": "Personel Düzenleme Formu"
    },
    {
      "key": "action",
      "type": "select-property",
      "options": [
        {
          "label": "Add",
          "value": "add"
        },
        {
          "label": "Get",
          "value": "get"
        },
        {
          "label": "Update",
          "value": "update"
        },
        {
          "label": "Custom",
          "value": "custom"
        },
        {
          "label": "Delete",
          "value": "delete"
        },
        {
          "label": "Hard delete",
          "value": "hardDelete"
        }
      ],
      "header": "Action",
      "value": "update"
    },
    {
      "key": "table-name",
      "header": "Table name",
      "type": "input-text-property",
      "value": "users",
      "conditions": [
        {
          "key": "action",
          "rule": "value != 'custom'"
        }
      ]
    },
    {
      "key": "field-id",
      "header": "Field id",
      "type": "input-text-property",
      "value": "{{users._id}}",
      "autoComplete": true,
      "autoCompleteMode": "template",
      "conditions": [
        {
          "key": "action",
          "rule": "value == 'update'"
        }
      ]
    },
    {
      "key": "hidden-values",
      "header": "Hidden values",
      "type": "code-editor",
      "value": "{\n\n}",
      "autoComplete": true,
      "autoCompleteMode": "template"
    },
    {
      "key": "on-success",
      "type": "select-property",
      "options": [
        {
          "label": "Reset form",
          "value": "reset"
        },
        {
          "label": "Route",
          "value": "route"
        },
        {
          "label": "Redirect",
          "value": "redirect"
        },
        {
          "label": "Nothing",
          "value": "nothing"
        }
      ],
      "header": "On success",
      "value": "route"
    },
    {
      "key": "response-name",
      "header": "Response name",
      "type": "input-text-property",
      "value": "",
      "autoComplete": true,
      "autoCompleteMode": "template"
    },
    {
      "key": "settings",
      "type": "checkbox-property",
      "header": "Settings",
      "options": [
        {
          "label": "Hidden",
          "name": "hidden"
        },
        {
          "label": "Has confirm",
          "name": "hasConfirm"
        },
        {
          "label": "Debug",
          "name": "debug"
        },
        {
          "label": "Debug response",
          "name": "debugResponse"
        },
        {
          "label": "Expose",
          "name": "expose"
        },
        {
          "label": "At Least Required Fields",
          "name": "minReqFields"
        }
      ],
      "value": {
        "hidden": false,
        "hasConfirm": false,
        "debug": false,
        "debugResponse": false,
        "expose": false,
        "minReqFields": false
      }
    }
  ],
  "photo": {
    "type": "input-file",
    "isContainer": false,
    "properties": [
      {
        "key": "display-name",
        "header": "Display name",
        "type": "input-text-property",
        "value": "Foto Ekle"
      },
      {
        "key": "classes",
        "header": "Classes",
        "type": "textarea-property",
        "value": ""
      },
      {
        "key": "name",
        "header": "Name",
        "type": "input-text-property",
        "value": "photo"
      },
      {
        "key": "label",
        "header": "Label",
        "type": "input-text-property",
        "value": "Foto Ekle:",
        "autoComplete": true,
        "autoCompleteMode": "template",
        "conditions": [
          {
            "key": "settings",
            "rule": "!value.inContainer"
          }
        ]
      },
      {
        "key": "accept",
        "header": "Accepted files",
        "type": "input-text-property",
        "value": ".png, .jpg"
      },
      {
        "key": "max-file-size",
        "header": "Max file size",
        "type": "input-text-property",
        "value": "5242880"
      },
      {
        "key": "file-limit",
        "header": "Max files",
        "type": "input-number-property",
        "value": 10,
        "min": 1,
        "conditions": [
          {
            "key": "settings",
            "rule": "value.multiple"
          }
        ]
      },
      {
        "key": "default-value",
        "header": "Default value",
        "type": "input-text-property",
        "value": "users.photo",
        "autoComplete": true,
        "autoCompleteMode": "variable"
      },
      {
        "key": "base-url",
        "header": "Base url",
        "type": "input-text-property",
        "value": "http://192.168.0.10/resources/",
        "autoComplete": true,
        "autoCompleteMode": "template"
      },
      {
        "key": "docker compose cropper-width",
        "header": "Cropper width",
        "type": "input-number-property",
        "value": 250,
        "min": 1,
        "conditions": [
          {
            "key": "settings",
            "rule": "value.cropper"
          }
        ]
      },
      {
        "key": "cropper-height",
        "header": "Cropper height",
        "type": "input-number-property",
        "value": 250,
        "min": 1,
        "conditions": [
          {
            "key": "settings",
            "rule": "value.cropper"
          }
        ]
      },
      {
        "key": "cropper-header",
        "header": "Cropper Header",
        "type": "input-text-property",
        "autoComplete": true,
        "autoCompleteMode": "template",
        "value": "Resim Yükle",
        "conditions": [
          {
            "key": "settings",
            "rule": "value.cropper"
          }
        ]
      },
      {
        "key": "cropper-button",
        "header": "Cropper Button Label",
        "type": "input-text-property",
        "value": "Kaydet",
        "autoComplete": true,
        "autoCompleteMode": "template",
        "conditions": [
          {
            "key": "settings",
            "rule": "value.cropper"
          }
        ]
      },
      {
        "key": "aspect-ratio",
        "type": "select-property",
        "options": [
          {
            "label": "1 / 1",
            "value": 1
          },
          {
            "label": "4 / 3",
            "value": 1.3333333333333333
          },
          {
            "label": "16 / 9",
            "value": 1.7777777777777777
          }
