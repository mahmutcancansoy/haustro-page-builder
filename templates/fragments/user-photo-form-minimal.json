          {
            "label": "As Base64",
            "name": "asBase64"
          },
          {
            "label": "In container",
            "name": "inContainer"
          },
          {
            "label": "Disabled",
            "name": "disabled"
          },
          {
            "label": "Multiple",
            "name": "multiple"
          },
          {
            "label": "Clear button",
            "name": "clear"
          },
          {
            "label": "Cropper",
            "name": "cropper"
          }
        ],
        "value": {
          "inContainer": false,
          "disabled": false,
          "multiple": false,
          "clear": false
        }
      }
