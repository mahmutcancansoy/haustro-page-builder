          {
            "key": "type-detail",
            "header": "Type detail",
            "type": "input-text-property",
            "value": "Geçerli dosya türleri: {0}",
            "inGroup": true
          },
          {
            "key": "limit-summary",
            "header": "Limit summary",
            "type": "input-text-property",
            "value": "Maksimum dosya adeti {0}",
            "inGroup": true
          },
          {
            "key": "limit-detail",
            "header": "Limit detail",
            "type": "input-text-property",
            "value": "Dosya yükleme limitini aştınız.",
            "inGroup": true
          }
        ]
      },
      {
        "key": "validators",
        "header": "Validators",
        "type": "group-property",
