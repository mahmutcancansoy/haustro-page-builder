{
  "type": "form-container",
  "isContainer": true,
  "children": [],
  "properties": [
    {
      "key": "display-name",
      "header": "Display name",
      "type": "input-text-property",
      "value": "Mail alıcı güncelleme formu"
    },
    {
      "key": "formId",
      "header": "Form ID",
      "type": "input-text-property",
      "value": ""
    },
    {
      "key": "submitId",
      "header": "Submit Button ID",
      "type": "input-text-property",
      "value": ""
    },
    {
      "key": "key",
      "header": "Key",
      "type": "input-text-property",
      "value": "",
      "autoComplete": true,
      "autoCompleteMode": "template",
      "conditions": [
        {
          "key": "settings",
          "rule": "value.expose"
        }
      ]
    },
    {
      "key": "action",
      "type": "select-property",
      "options": [
        {
          "label": "Add",
          "value": "add"
        },
        {
          "label": "Get",
          "value": "get"
        },
        {
          "label": "Update",
          "value": "update"
        },
        {
          "label": "Custom",
          "value": "custom"
        },
        {
          "label": "Delete",
          "value": "delete"
        },
        {
          "label": "Hard delete",
          "value": "hardDelete"
        }
      ],
      "header": "Action",
      "value": "custom"
    },
    {
      "key": "custom-function-name",
      "header": "Custom function name",
      "type": "input-text-property",
      "value": "mailRecipients",
      "conditions": [
        {
          "key": "action",
          "rule": "value == 'custom'"
        }
      ]
    },
    {
      "key": "table-name",
      "header": "Table name",
      "type": "input-text-property",
      "value": "mailRecipients",
      "conditions": [
        {
          "key": "action",
          "rule": "value != 'custom'"
        }
      ]
    },
    {
      "key": "field-id",
      "header": "Field id",
      "type": "input-text-property",
      "value": "{{mailRecipients._id}}",
      "autoComplete": true,
      "autoCompleteMode": "template",
      "conditions": [
        {
          "key": "action",
          "rule": "value == 'update'"
        }
      ]
    },
    {
      "key": "hidden-values",
      "header": "Hidden values",
      "type": "code-editor",
      "value": "{\n  \"oprType\": \"addRecipient\",\n  \"_id\": \"{{params._id}}\"\n}",
      "autoComplete": true,
      "autoCompleteMode": "template"
    },
    {
      "key": "table-filters",
      "header": "Table filters",
      "type": "code-editor",
      "value": "{\n\n}",
      "autoComplete": true,
      "autoCompleteMode": "template",
      "conditions": [
        {
          "key": "action",
          "rule": "value == 'custom'"
        }
      ]
    },
    {
      "key": "on-success",
      "type": "select-property",
      "options": [
        {
          "label": "Reset form",
          "value": "reset"
        },
        {
          "label": "Route",
          "value": "route"
        },
        {
          "label": "Redirect",
          "value": "redirect"
        },
        {
          "label": "Nothing",
          "value": "nothing"
        }
      ],
      "header": "On success",
      "value": "route"
    },
    {
      "key": "url",
      "header": "Url",
      "type": "textarea-property",
      "value": "/d/mail-alici-duzenle",
      "autoComplete": true,
      "autoCompleteMode": "template",
      "conditions": [
        {
          "key": "on-success",
          "rule": "value == 'redirect' || value == 'route'"
        }
      ]
    },
    {
      "key": "query-params",
      "header": "Query Params",
      "type": "code-editor",
      "value": "{\n    \"_id\": \"{{params._id}}\"\n}",
      "autoComplete": true,
      "autoCompleteMode": "template",
      "conditions": [
        {
          "key": "on-success",
          "rule": "value == 'route'"
        }
      ]
    },
    {
      "key": "response-name",
      "header": "Response name",
      "type": "input-text-property",
      "value": "",
      "autoComplete": true,
      "autoCompleteMode": "template"
    },
    {
      "key": "on-success-message",
      "header": "On success message",
      "type": "group-property",
      "children": [
        {
          "key": "header",
          "header": "Header",
          "type": "input-text-property",
          "value": "Başarılı",
          "inGroup": true
        },
        {
          "key": "text",
          "header": "Text",
          "type": "textarea-property",
          "value": "Mail alıcıları güncellendi.",
          "inGroup": true
        },
        {
          "key": "popUp",
          "header": "Pop Up View",
          "type": "checkbox-property",
          "options": [
            {
              "label": "Enable",
              "name": "popUpView"
            }
          ],
          "value": {
            "popUpView": true
          },
          "inGroup": true
        },
        {
          "key": "life",
          "header": "Life",
          "type": "input-number-property",
          "value": 3000,
          "min": 0,
          "inGroup": true
        },
        {
          "key": "severity",
          "type": "select-property",
          "options": [
            {
              "label": "Success",
              "value": "success"
            },
            {
              "label": "Info",
              "value": "info"
            },
            {
              "label": "Warning",
              "value": "warn"
            },
            {
              "label": "Error",
              "value": "error"
            }
          ],
          "header": "Severity",
          "value": "success",
          "inGroup": true
        }
      ]
    },
    {
      "key": "confirm",
      "header": "Confirm",
      "type": "group-property",
      "children": [
        {
          "key": "header",
          "header": "Header",
          "type": "input-text-property",
          "value": "",
          "autoComplete": true,
          "autoCompleteMode": "template",
          "inGroup": true
        },
        {
          "key": "content",
          "header": "Content",
          "type": "textarea-property",
          "value": "",
          "autoComplete": true,
          "autoCompleteMode": "template",
          "inGroup": true
        },
        {
          "key": "accept",
          "header": "Accept",
          "type": "input-text-property",
          "value": "",
          "autoComplete": true,
          "autoCompleteMode": "template",
          "inGroup": true
        },
        {
          "key": "reject",
          "header": "Reject",
          "type": "input-text-property",
          "value": "",
          "autoComplete": true,
          "autoCompleteMode": "template",
          "inGroup": true
        }
      ],
      "conditions": [
        {
          "key": "settings",
          "rule": "value.hasConfirm"
        }
      ]
    },
    {
      "key": "upload-title",
      "header": "File upload title",
      "type": "input-text-property",
      "value": "Dosyalar yükleniyor..."
    },
    {
      "key": "settings",
      "type": "checkbox-property",
      "header": "Settings",
      "options": [
        {
          "label": "Hidden",
          "name": "hidden"
        },
        {
          "label": "Has confirm",
          "name": "hasConfirm"
        },
        {
          "label": "Debug",
          "name": "debug"
        },
        {
          "label": "Debug response",
          "name": "debugResponse"
        },
        {
          "label": "Expose",
          "name": "expose"
        },
        {
          "label": "At Least Required Fields",
          "name": "minReqFields"
        }
      ],
      "value": {
        "hidden": false,
        "hasConfirm": false,
        "debug": false,
        "debugResponse": false,
        "expose": false,
        "minReqFields": false
      }
    },
    {
      "key": "reqFieldsArr",
      "header": "At least Req fields",
      "type": "textarea-property",
      "value": "",
      "conditions": [
        {
          "key": "settings",
          "rule": "value.minReqFields"
        }
      ]
    },
    {
      "key": "atLeastError",
      "header": "On Fill At Least Msg",
      "type": "group-property",
      "conditions": [
        {
          "key": "settings",
          "rule": "value.minReqFields"
        }
      ],
      "children": [
        {
          "key": "header",
          "header": "Header",
          "type": "input-text-property",
          "value": "",
          "inGroup": true
        },
        {
          "key": "text",
          "header": "Text",
          "type": "textarea-property",
          "value": "",
          "inGroup": true
        }
      ]
    }
  ]
}
